# Copy to .env. Leave ANTHROPIC_API_KEY empty to run the deterministic mock orchestrator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Observability (Arize Phoenix). start.sh runs Phoenix on :6006 for you.
# Set SDL_TRACING=off to disable tracing. If Phoenix is not running, tracing is skipped automatically.
SDL_TRACING=on
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
SDL_PHOENIX_PROJECT=sdl-control-plane
